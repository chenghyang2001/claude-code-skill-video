# Claude Code Skill 技術探討：環境變數範本（複製成 .env 後填值，.env 不進版控）
# 注意：不要在這裡或任何全域環境設定 Anthropic API 金鑰，腳本一律走 claude -p 的 Max 訂閱額度

# 【必要】kindle-98 repo 路徑（讀 doc/demos/*.md 與 code/）
KINDLE_REPO=~/workspace/kindle-98-ai-skill-10x-guide

# 【必要，dry-run 除外】YouTube OAuth token（scope youtube.force-ssl，需含 refresh_token；權限 600）
YT_TOKEN_PATH=~/.config/skillvideo/youtube-token.json
# 系列播放清單 ID；留空則首次自動建立並寫回 state.json
YT_PLAYLIST_ID=

# 【必要，dry-run 除外】Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 【必要，dry-run 除外】Gmail SMTP 通知（應用程式密碼，不是登入密碼）
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# 產物目錄（預設 ~/skillvideo-work），保留 7 天
WORK_DIR=
# claude CLI 路徑（預設自動偵測；Windows npm 版會自動由 claude.cmd 解析到 claude.exe）
CLAUDE_BIN=
# Chrome / Chromium 路徑（預設依平台偵測）
CHROME_BIN=
# 語音與語速
TTS_VOICE=zh-TW-HsiaoChenNeural
TTS_RATE=+8%
